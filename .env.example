# skfiy-next environment variables
# Copy to .env and fill in as needed. All are optional — the app runs with zero env vars.

# Dev server (npm run dev:electron)
SKFIY_DEV_SERVER_URL=http://127.0.0.1:5173

# Background Agent provider binaries (override PATH lookup)
# SKFIY_CODEX_BIN=/opt/homebrew/bin/codex
# SKFIY_CLAUDE_CODE_BIN=/opt/homebrew/bin/claude
# SKFIY_HERMES_BIN=/opt/homebrew/bin/hermes

# Planner (local-deterministic | external-cua | disabled)
# SKFIY_PLANNER_MODE=local-deterministic
# SKFIY_EXTERNAL_CUA_ENDPOINT=
# SKFIY_EXTERNAL_CUA_API_KEY=

# Smoke testing (scripts/smoke-*.mjs)
# SKFIY_BYPASS_APPROVAL=strict
# SKFIY_SMOKE_WINDOW_MODE=hidden
# SKFIY_SMOKE_ASSISTANT_PROMPT=你好 skfiy
# SKFIY_SMOKE_ASSISTANT_REPLY=你好，我是 skfiy。

# macOS helper override (defaults to bundled dist/skfiy-helper)
# SKFIY_HELPER_PATH=

# Signed releases (optional — unsigned alpha path works without these)
# SKFIY_DEVELOPER_ID_APPLICATION="Developer ID Application: ..."
# APPLE_ID=
# APPLE_TEAM_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
